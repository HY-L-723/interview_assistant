# Backend runtime
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/interview_assistant?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# Security
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION=86400000

# AI provider
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=60000
CHAT_CONTEXT_MESSAGE_LIMIT=20

# Web and file storage
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB

# Interview defaults
INTERVIEW_DEFAULT_QUESTION_COUNT=5
INTERVIEW_MAX_QUESTION_COUNT=10
